<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    {{>header}}

    <section class="main-content">

        <h1>{{pageTitle}}</h1>

        <p class="intro-text">Discover new movies, find similar titles and curate your taste with amazing movie options through the search below.</p>

   

        <form action="/search">
            <input placeholder="Search for a movie title here" name="movie" type="text" required>
            <button type="submit">Search</button>
        </form>

        <img src="/images/example.jpg" class="example-image">

        </div>

        <div>
            <h2>Your curated watchlist</h2>
            {{#if watchlist}}
        <ul id="watchlist">
            {{#each movies}}
                <li class="movie-item">

                    {{#if poster_path}}
                        <img
                            src="https://image.tmdb.org/t/p/w500{{poster_path}}"
                            alt="{{title}} poster"
                            class="movie-poster"
                        >
                    {{else}}
                        <div class="poster-placeholder">
                            No image available
                        </div>
                    {{/if}}

                    <h3>{{title}}</h3>

                </li>
            {{/each}}
        </ul>
        {{else}}
        <p>No similar movies were found. Please try a new title.</p>
        
        {{/if}}
        </div>

    </section>
    

    {{>footer}}
</body>
</html>

