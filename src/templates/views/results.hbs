

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    {{> header}}

    <div class="main-content">
    <section class="results-header">
        <h1>{{pageTitle}}</h1>
        <p class="results-subtitle">Search through results and find similar movies and widen your horizon.</p>
         <form action="/search">
        <input placeholder="Search for a new movie title here" name="movie" type="text" required>
        <button type="submit">Search</button>
    </form>
    </section>


{{#if movies.length}}
<ul id="movie-list">
    {{#each movies}}
        <li class="movie-item">

            {{#if poster_path}}
                <img
                    src="https://image.tmdb.org/t/p/w500{{poster_path}}"
                    alt="{{title}} poster"
                    class="movie-poster"
                >
            {{else}}
                <div class="poster-placeholder">
                    No image available
                </div>
            {{/if}}

            <h3>{{title}}</h3>

            <p class="overview">{{overview}}</p>

            <p class="release-year">
                Release date: {{release_date}}
            </p>

            <a href="/similar?id={{id}}">
                View similar movies
            </a>

        </li>
    {{/each}}
</ul>
{{else}}
<p>No similar movies were found. Please try a new title.</p>

{{/if}}

</div>

{{> footer}}

</body>
</html>
